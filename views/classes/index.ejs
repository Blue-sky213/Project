<%- include('../partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-calendar-check text-primary"></i> จัดการคลาสเรียน (Classes)</h2>
        </div>
        <div class="col-auto text-end">
            <a href="/" class="btn btn-outline-dark me-2"><i class="bi bi-house-door"></i> หน้าหลัก</a>
            <a href="/classes/new" class="btn btn-success shadow-sm"><i class="bi bi-plus-circle"></i> เพิ่มคลาสใหม่</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3">รหัสคลาส</th>
                        <th class="py-3 text-start">ชื่อคลาส</th>
                        <th class="py-3">เวลาเรียน</th>
                        <th class="py-3">ความจุ (คน)</th>
                        <th class="py-3">เทรนเนอร์ผู้สอน</th>
                        <th class="py-3">การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (classes && classes.length > 0) { %>
                        <% classes.forEach(c => { %>
                            <tr>
                                <td class="fw-bold text-secondary"><%= c.id %></td>
                                <td class="text-start fw-bold text-primary"><%= c.className %></td>
                                <td><%= c.scheduleTime %></td>
                                <td><span class="badge bg-info text-dark"><%= c.capacity %></span></td>
                                <td class="fw-bold"><%= c.trainer ? c.trainer.username : 'ยังไม่ระบุ' %></td>
                                <td>
                                    <div class="btn-group shadow-sm">
                                        <a href="/classes/<%= c.id %>" class="btn btn-sm btn-info text-white" title="ดูรายละเอียด"><i class="bi bi-search"></i></a>
                                        <a href="/classes/<%= c.id %>/edit" class="btn btn-sm btn-warning" title="แก้ไข"><i class="bi bi-pencil"></i></a>
                                        
                                        <button type="button" class="btn btn-sm btn-danger" onclick="confirmDeleteClass('<%= c.id %>', '<%= c.className %>')" title="ลบ"><i class="bi bi-trash"></i></button>
                                        <form id="delete-class-<%= c.id %>" action="/classes/<%= c.id %>?_method=DELETE" method="POST" style="display: none;"></form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i> ยังไม่มีข้อมูลคลาสเรียนในระบบ
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function confirmDeleteClass(id, name) {
    Swal.fire({
        title: 'ยืนยันการลบคลาสเรียน?',
        text: `คุณกำลังจะลบคลาส "${name}" ข้อมูลนี้ไม่สามารถกู้คืนได้!`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'ใช่, ลบเลย!',
        cancelButtonText: 'ยกเลิก',
        reverseButtons: true
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-class-' + id).submit();
        }
    });
}
</script>

<%- include('../partials/footer') %>