<%- include('../partials/header') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 text-center">
                    <h3 class="mb-0"><i class="bi bi-info-circle"></i> ข้อมูลการลงทะเบียน</h3>
                    <p class="mb-0 opacity-75">รหัส: <%= enrollment.enrollment_code %></p>
                </div>
                
                <div class="card-body p-5 bg-light">
                    <div class="bg-white p-4 rounded-3 shadow-sm mb-4">
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-bold">ชื่อสมาชิก:</div>
                            <div class="col-sm-8 fw-bold text-primary fs-5"><%= enrollment.User.username %></div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-bold">อีเมล:</div>
                            <div class="col-sm-8"><%= enrollment.User.email %></div>
                        </div>
                        <hr>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-bold">คลาสเรียน:</div>
                            <div class="col-sm-8 fw-bold"><%= enrollment.Class.className %></div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted fw-bold">เวลาเรียน:</div>
                            <div class="col-sm-8"><%= enrollment.Class.scheduleTime %></div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-4 text-muted fw-bold">สถานะ:</div>
                            <div class="col-sm-8">
                                <% if (enrollment.status === 'active') { %>
                                    <span class="badge bg-success">ACTIVE</span>
                                <% } else { %>
                                    <span class="badge bg-danger">CANCELLED</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-sm-flex justify-content-center">
                        <a href="/enrollments/<%= enrollment.id %>/edit" class="btn btn-warning px-4 fw-bold shadow-sm rounded-pill"><i class="bi bi-pencil-square me-1"></i> แก้ไขข้อมูล</a>
                        <a href="/enrollments" class="btn btn-outline-secondary px-4 fw-bold shadow-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> กลับหน้ารายการ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>